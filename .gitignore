# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Output data
output/sessions/
recordings/
calibration/intrinsics/results/


# specific folders and files
docs/
.claude/

# Calibration (machine-specific, not committed)
*.json
*.jpg
*.png

# Track the ROI/mask config -- painted once per camera mount, not regenerable
!calibration/roi/roi.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Mypy
.mypy_cache/

# Track only the latest calibration.json (intrinsics travel with the code)
!calibration/intrinsics/results/
calibration/intrinsics/results/*
!calibration/intrinsics/results/20260701_180005_calibration/
calibration/intrinsics/results/20260701_180005_calibration/*
!calibration/intrinsics/results/20260701_180005_calibration/calibration.json

# Track the split manifest (nbstripout erases notebook outputs, so this is the only
# committed record of which mounts and trials each fold held out)
!notebooks/split_manifest.json

# Track images referenced by README.md, and the agent-skill config the skills read
!docs/
docs/*
!docs/images/
!docs/images/**
!docs/agents/
!docs/agents/**

# MLflow tracking store and run artifacts (notebook 03 onward). Regenerable; large.
mlflow.db
mlruns/
mlartifacts/

# Per-fold results written live during a long model run, as crash insurance. Derived from
# the notebook; the durable record is the "7x results" markdown cell.
notebooks/*_results_live.csv
